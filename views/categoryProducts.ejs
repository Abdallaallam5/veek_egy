<%- include('partials/header', { title: category }) %>

<div class="container">
  <header class="page-hero">
    <span class="eyebrow"><a href="/collections">Collections</a> / <%= category %></span>
    <h1 class="display page-hero__title lines">
      <span class="line"><span><%= category %><sup class="section-head__count"><%= String(products.length).padStart(2, '0') %></sup></span></span>
    </h1>
  </header>

  <% if (!products.length) { %>
    <div class="empty-state">
      <p class="display">Nothing here yet</p>
      <p>This collection is being restocked. Check back soon.</p>
      <a href="/collections" class="btn">All collections</a>
    </div>
  <% } else { %>
    <div class="grid" style="padding-bottom:clamp(56px,8vw,110px)">
      <% products.forEach(product => { %>
        <%- include('partials/product-card', { product }) %>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
