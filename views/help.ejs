<%- include('partials/header', { title: 'Help' }) %>

<div class="container" style="padding-bottom:clamp(56px,8vw,110px)">
  <header class="page-hero">
    <span class="eyebrow">Help center</span>
    <h1 class="display page-hero__title lines"><span class="line"><span>How can we help?</span></span></h1>
    <p class="page-hero__meta" data-reveal style="--d:300">Everything about shipping, returns and your orders — in one place.</p>
  </header>

  <div class="tabs" role="tablist" data-reveal>
    <span class="tabs__ink" aria-hidden="true"></span>
    <button class="tab-btn active" role="tab" data-tab="shipping">Shipping policy</button>
    <button class="tab-btn" role="tab" data-tab="return">Return &amp; exchange</button>
    <button class="tab-btn" role="tab" data-tab="faqs">FAQs</button>
  </div>

  <!-- Shipping -->
  <div class="tab-panel prose active" id="shipping" role="tabpanel">
    <h2>Shipping policy</h2>

    <h3>Delivery time</h3>
    <p>Orders are delivered within 5–7 business days in Cairo, Giza, and Alexandria, and up to 8 business days for other governorates.</p>

    <h3>Delivery attempts</h3>
    <p>Our shipping partner will attempt delivery up to 3 times and will contact you using the phone number provided during checkout.</p>

    <h3>Undelivered orders</h3>
    <p>If the order cannot be delivered after 3 attempts, it will be automatically returned and marked as a returned order.</p>

    <h3>Important note</h3>
    <p>Please make sure your contact details and delivery address are accurate to avoid delays or missed deliveries.</p>

    <h3>Need help?</h3>
    <p>For any questions or support, feel free to contact us via email: <strong>veekegy@gmail.com</strong></p>
  </div>

  <!-- Return -->
  <div class="tab-panel prose" id="return" role="tabpanel">
    <h2>Veek return &amp; exchange policy</h2>

    <p>At Veek, we want you to love every piece you order. If you are not completely satisfied, you can return or exchange your order within 14 days of delivery.</p>

    <h3>Conditions for return / exchange</h3>
    <ul>
      <li>Items must be unworn, unwashed, and in original condition.</li>
      <li>Customized or printed items are non-returnable unless defective.</li>
      <li>Sale, clearance, or end-of-season items are non-refundable.</li>
    </ul>

    <h3>Defective or wrong items</h3>
    <ul>
      <li>If your item is defective or the wrong product was delivered, Veek covers all shipping costs.</li>
      <li>A replacement or refund will be provided at no extra charge.</li>
    </ul>

    <h3>Shipping &amp; costs</h3>
    <ul>
      <li>Customers are responsible for return shipping unless the item is defective or incorrect.</li>
      <li>Exchange shipping costs are collected by the courier upon delivery.</li>
    </ul>

    <h3>How to return or exchange</h3>
    <p>Customers can request returns or exchanges through:</p>
    <ul>
      <li>Email: <strong>veekegy@gmail.com</strong></li>
      <li>Instagram</li>
      <li>WhatsApp</li>
      <li>Facebook</li>
    </ul>
    <p>Our team will confirm your request and guide you through the process.</p>

    <h3>Refunds &amp; exchanges</h3>
    <ul>
      <li>Refunds are processed through the original payment method within 10–14 business days after receiving the returned item.</li>
      <li>Exchanges are processed within 5–10 business days depending on stock availability.</li>
    </ul>

    <h3>Customer rights &amp; legal notice</h3>
    <p>This policy is in accordance with the Egyptian Consumer Protection Law No. 181 of 2018.</p>
    <p>If you have any questions, our team is always here to help and make your experience smooth and fair.</p>
  </div>

  <!-- FAQs -->
  <div class="tab-panel" id="faqs" role="tabpanel">
    <% [
      ["How can I purchase your products?", "You can purchase through our website."],
      ["Can I open the package before paying the courier?", "Unfortunately, no. Couriers are not allowed to wait for try-ons or return with opened packages."],
      ["Where can I find the size chart?", "The size chart is available on our Size Guide page and linked from every product page."],
      ["How long does delivery take?", "Orders are delivered within 5–7 business days in Cairo, Giza, and Alexandria, and up to 8 business days for other governorates."],
      ["Can I make my order arrive faster?", "Unfortunately, delivery times cannot be expedited."],
      ["Do you have a physical store?", "No, we operate exclusively online."],
      ["Do you allow exchanges / returns?", "Yes, according to our return and exchange policy."],
      ["How can I request a refund, exchange, or cancel my order?", "Contact us at veekegy@gmail.com or via our social media pages."],
      ["How can I contact you?", "Through DM, our Contact page, or email: veekegy@gmail.com."],
      ["What happens if the courier cannot deliver my order?", "After 3 attempts, the order will be returned automatically."],
      ["Can I order two sizes of the same item?", "No, such orders are not allowed and may be canceled automatically."]
    ].forEach(([q, a], i) => { %>
      <details class="acc">
        <summary><%= q %> <span class="plus"></span></summary>
        <div class="acc__body"><%= a %></div>
      </details>
    <% }) %>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var tabs = document.querySelectorAll(".tab-btn");
  var ink = document.querySelector(".tabs__ink");

  function moveInk(btn) {
    ink.style.width = btn.offsetWidth + "px";
    ink.style.transform = "translateX(" + btn.offsetLeft + "px)";
  }

  function show(id, push) {
    var btn = document.querySelector('.tab-btn[data-tab="' + id + '"]');
    if (!btn) return;
    tabs.forEach(function (t) { t.classList.toggle("active", t === btn); });
    document.querySelectorAll(".tab-panel").forEach(function (p) { p.classList.toggle("active", p.id === id); });
    moveInk(btn);
    if (push) history.replaceState(null, "", "#" + id);
  }

  tabs.forEach(function (t) {
    t.addEventListener("click", function () { show(t.dataset.tab, true); });
  });

  show((location.hash || "#shipping").slice(1) || "shipping", false);
  window.addEventListener("resize", function () { moveInk(document.querySelector(".tab-btn.active")); });
  window.addEventListener("hashchange", function () { show(location.hash.slice(1), false); });
});
</script>

<%- include('partials/footer') %>
