<%- include('partials/header', { title: 'Shop all' }) %>

<div class="container">
  <header class="page-hero">
    <span class="eyebrow">Everything</span>
    <h1 class="display page-hero__title lines">
      <span class="line"><span>Shop all<sup class="section-head__count"><%= String(products.length).padStart(2, '0') %></sup></span></span>
    </h1>
  </header>

  <div class="grid" style="padding-bottom:clamp(56px,8vw,110px)">
    <% products.forEach(product => { %>
      <%- include('partials/product-card', { product }) %>
    <% }) %>
  </div>
</div>

<%- include('partials/footer') %>
