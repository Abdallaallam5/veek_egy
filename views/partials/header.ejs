<%
  const pageTitle = (typeof title !== 'undefined' && title) ? title + ' — VEEK' : 'VEEK — Crafted to elevate your every day';
  const bagCount = typeof cartCount !== 'undefined' ? Number(cartCount) || 0 : 0;
%>
<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= pageTitle %></title>
  <meta name="description" content="VEEK — sophisticated essentials in neutral tones. Designed to move with you. Shipping all over Egypt.">
  <meta name="theme-color" content="#0a0a0a">
  <link rel="icon" type="image/jpeg" href="/images/photo_2026-01-06_18-49-05.jpg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/veek.css">
  <script>document.documentElement.className = document.documentElement.className.replace("no-js", "js");</script>
</head>
<body>

<a class="sr-only" href="#main">Skip to content</a>

<!-- ================= LOADER ================= -->
<div class="loader" id="loader" aria-hidden="true">
  <div class="loader__word">
    <% 'VEEK'.split('').forEach((ch, i) => { %><span style="--i:<%= i %>"><%= ch %></span><% }) %>
  </div>
  <div class="loader__bar"></div>
</div>

<!-- ================= ANNOUNCEMENT ================= -->
<div class="announce" role="region" aria-label="Announcements">
  <% for (let r = 0; r < 2; r++) { %>
  <div class="announce__track" <%- r ? 'aria-hidden="true"' : '' %>>
    <span>Free shipping over 1499 EGP</span>
    <span>Up to 20% off — Sale is live</span>
    <span>Shipping all over Egypt</span>
    <span>14-day easy exchange</span>
    <span>Free shipping over 1499 EGP</span>
    <span>Up to 20% off — Sale is live</span>
    <span>Shipping all over Egypt</span>
    <span>14-day easy exchange</span>
  </div>
  <% } %>
</div>

<!-- ================= HEADER ================= -->
<header class="site-header">
  <div class="container site-header__inner">

    <nav aria-label="Main">
      <button class="icon-btn menu-btn" id="menuBtn" aria-label="Menu" aria-expanded="false" aria-controls="drawer">
        <span class="bars"></span>
      </button>
      <ul class="nav">
        <li><a href="/">Home</a></li>
        <li><a href="/collections">Collections</a></li>
        <li><a href="/sale" class="is-sale">Sale</a></li>
        <li><a href="/size-guide">Size Guide</a></li>
        <li><a href="/help">Help</a></li>
      </ul>
    </nav>

    <a href="/" class="brand" aria-label="VEEK home">VEEK</a>

    <div class="header-actions">
      <a href="/contact" class="icon-btn" aria-label="Contact us">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 7l9 6 9-6"/></svg>
      </a>
      <a href="/cart" class="icon-btn" aria-label="Shopping bag">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 016 0v2"/></svg>
        <span class="cart-badge <%= bagCount ? '' : 'is-empty' %>" id="cart-count" data-cart-count><%= bagCount %></span>
      </a>
    </div>

  </div>
</header>

<!-- ================= MOBILE DRAWER ================= -->
<div class="drawer" id="drawer">
  <div class="drawer__backdrop" data-close-menu></div>
  <div class="drawer__panel">
    <ul class="drawer__links">
      <li><a href="/" style="--i:0">Home</a></li>
      <li><a href="/collections" style="--i:1">Collections</a></li>
      <li><a href="/sale" style="--i:2">Sale</a></li>
      <li><a href="/size-guide" style="--i:3">Size Guide</a></li>
      <li><a href="/help" style="--i:4">Help</a></li>
      <li><a href="/contact" style="--i:5">Contact</a></li>
    </ul>
    <div class="drawer__foot">
      <p>veekegy@gmail.com</p>
      <p>© <%= new Date().getFullYear() %> VEEK Clothing</p>
    </div>
  </div>
</div>

<main class="page" id="main">
