<!-- ================= QUICK ADD ================= -->
<div class="modal" id="quickAdd" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="qaName">
  <div class="modal__backdrop" data-modal-close></div>
  <div class="modal__box">
    <button class="icon-btn modal__close" data-modal-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <div class="modal__product">
      <img id="qaImage" src="" alt="">
      <div>
        <h3 id="qaName"></h3>
        <div class="price"><span class="price__now" id="qaPrice"></span></div>
      </div>
    </div>

    <div class="modal__group">
      <span class="label">Size</span>
      <div id="qaSizes"></div>
    </div>

    <div class="modal__group">
      <span class="label">Color</span>
      <div id="qaColors"></div>
    </div>

    <div class="modal__actions">
      <div class="qty">
        <button type="button" data-qty="-1" aria-label="Decrease">−</button>
        <input id="qaQty" type="number" value="1" min="1" max="10" aria-label="Quantity">
        <button type="button" data-qty="1" aria-label="Increase">+</button>
      </div>
      <button type="button" class="btn" id="qaConfirm">Add to bag</button>
    </div>
  </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

