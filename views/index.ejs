<%- include('partials/header') %>

<div class="container">
  <% productsByCategory.forEach(section => { %>
    <section class="section">
      <div class="section-head">
        <h2 class="display section-head__title"><%= section.category.name || section.category %></h2>
      </div>
      <div class="grid">
        <% section.products.forEach(product => { %>
          <%- include('partials/product-card', { product }) %>
        <% }) %>
      </div>
    </section>
  <% }) %>
</div>

<%- include('partials/footer') %>
