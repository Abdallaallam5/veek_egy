<%- include('partials/header', { title: 'Size guide' }) %>

<div class="container" style="padding-bottom:clamp(56px,8vw,110px)">
  <header class="page-hero" style="margin-bottom:0;border-bottom:0">
    <span class="eyebrow">Find your fit</span>
    <h1 class="display page-hero__title lines"><span class="line"><span>Size guide</span></span></h1>
    <p class="page-hero__meta" data-reveal style="--d:300">All measurements are in centimeters. Tap a chart to enlarge it.</p>
  </header>

  <% [
    { name: 'Hoodies', imgs: ['/images/Screenshot 2026-04-09 153643.jpg'] },
    { name: 'T-Shirts', imgs: ['/images/Screenshot 2026-04-09 153035.jpg', '/images/Screenshot 2026-04-09 153346.jpg'] },
    { name: 'Sweatpants', imgs: ['/images/Screenshot 2026-04-09 153518.jpg'] }
  ].forEach(group => { %>
    <section class="size-block">
      <h2 class="display size-block__title lines"><span class="line"><span><%= group.name %></span></span></h2>
      <div class="size-block__imgs">
        <% group.imgs.forEach((src, i) => { %>
          <button type="button" data-lightbox="<%= src %>" data-reveal style="--d:<%= i * 120 %>" aria-label="Enlarge <%= group.name %> size chart">
            <img src="<%= src %>" alt="<%= group.name %> size chart" loading="lazy">
          </button>
        <% }) %>
      </div>
    </section>
  <% }) %>
</div>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Size chart">
  <img src="" alt="Size chart">
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var box = document.getElementById("lightbox");
  var img = box.querySelector("img");
  document.querySelectorAll("[data-lightbox]").forEach(function (b) {
    b.addEventListener("click", function () {
      img.src = b.dataset.lightbox;
      box.classList.add("is-open");
      document.body.classList.add("no-scroll");
    });
  });
  function close() {
    box.classList.remove("is-open");
    document.body.classList.remove("no-scroll");
  }
  box.addEventListener("click", close);
  document.addEventListener("keydown", function (e) { if (e.key === "Escape") close(); });
});
</script>

<%- include('partials/footer') %>
