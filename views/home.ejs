<%- include('partials/header') %>

<%
  // Summer Collection always leads the page (display order only, DB untouched)
  const isSummer = s => /summer/i.test((s.category && s.category.name) || '');
  const sections = (productsByCategory || [])
    .filter(s => s.products && s.products.length)
    .sort((a, b) => isSummer(b) - isSummer(a));

  // Pieces for the rack: newest sections first, in-stock first, one per product, max 9
  const seen = new Set();
  const all = [];
  sections.forEach(sec => sec.products.forEach(pr => {
    const id = String(pr._id);
    if (!seen.has(id) && pr.images && pr.images[0]) { seen.add(id); all.push(pr); }
  }));
  // Pieces photographed alone on a hanger (transparent background) hang on the rack
  // in this order. Display only — product data is untouched.
  const R = '/images/rack/';
  // [product id, hanger shot, side that shot shows, optional other side shown when the 3D piece turns]
  const CUTOUTS = [
    ['69e7a2e298d70be7abbfa362', R + 'cursed-eye-back.webp', 'back', R + 'cursed-eye-front.webp?v=6'],
    ['69e7aa97342941174bb0982f', R + 'darwish-back.webp', 'back', R + 'darwish-front.webp?v=6'],
    ['69e7aa5f342941174bb0982e', R + 'japan-back.webp', 'back', R + 'japan-front.webp?v=6'],
    ['69e7a24098d70be7abbfa361', R + 'olive-land-back.webp', 'back', R + 'olive-land-front.webp?v=6'],
    ['69e7ab7f342941174bb09830', R + 'red-empire-back.webp', 'back', R + 'red-empire-front.webp?v=6'],
    ['69ee0c3ea973fc9752a175c8', R + 'relaxed-polo.webp', 'front', R + 'relaxed-polo-back.webp?v=6'],
    ['69ee52634f5f9da15449f7d3', R + 'silent-threat-front.webp', 'front', R + 'silent-threat-back.webp?v=6'],
    ['69ee0de56ce13fba4f935173', R + 'straight-leg-sweatpants.webp', 'front', R + 'straight-leg-sweatpants-back.webp?v=6']
  ];
  const cutoutItems = CUTOUTS
    .map(([id, cutout, shotSide, turn]) => {
      const pr = all.find(x => String(x._id) === id);
      return pr ? Object.assign({}, pr, { cutout, shotSide, turn: turn || '' }) : null;
    })
    .filter(Boolean);

  // fall back to regular product photos if the hanger shots don't match the catalogue
  const rackItems = cutoutItems.length >= 3
    ? cutoutItems
    : all.filter(pr => Number(pr.stock) > 0)
        .concat(all.filter(pr => Number(pr.stock) <= 0))
        .slice(0, 9);
%>

<!-- ================= RACK HERO ================= -->
<% if (rackItems.length) { %>
  <%- include('partials/rack', { items: rackItems }) %>
<% } %>

<!-- ================= CATEGORIES ================= -->
<div id="shop">
<% if (!sections.length) { %>
  <div class="container empty-state">
    <p class="display">New drop soon</p>
    <p>We’re preparing something special. Check back shortly.</p>
  </div>
<% } %>

<% sections.forEach((section, si) => { %>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="display section-head__title lines">
          <span class="line"><span><%= section.category.name %><sup class="section-head__count"><%= String(section.products.length).padStart(2, '0') %></sup></span></span>
        </h2>
        <a href="/collections/<%= section.category._id %>" class="link-arrow" data-reveal="fade">View all <span>→</span></a>
      </div>

      <div class="grid">
        <% section.products.forEach(product => { %>
          <%- include('partials/product-card', { product }) %>
        <% }) %>
      </div>
    </div>
  </section>

  <% if (si === 0) { %>
    <section class="section">
      <div class="container">
        <div class="values">
          <div class="value" data-reveal style="--d:0">
            <span class="value__num">01</span>
            <h3>Free shipping</h3>
            <p>On every order over 1499 EGP, anywhere in Egypt.</p>
          </div>
          <div class="value" data-reveal style="--d:120">
            <span class="value__num">02</span>
            <h3>Easy exchange</h3>
            <p>Not the right fit? Exchange within 14 days of delivery.</p>
          </div>
          <div class="value" data-reveal style="--d:240">
            <span class="value__num">03</span>
            <h3>Cash on delivery</h3>
            <p>Pay when your order arrives at your door.</p>
          </div>
        </div>
      </div>
    </section>
  <% } %>
<% }) %>
</div>

<%- include('partials/footer') %>
