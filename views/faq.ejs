<%- include('partials/header', { title: 'FAQs' }) %>

<div class="container" style="max-width:900px;padding-bottom:clamp(56px,8vw,110px)">
  <header class="page-hero">
    <span class="eyebrow">Help</span>
    <h1 class="display page-hero__title lines"><span class="line"><span>FAQs</span></span></h1>
  </header>

  <% [
    ["How can I purchase your products?", "You can purchase through our website."],
    ["Can I open the package before paying the courier?", "Unfortunately, you cannot. Couriers are not allowed to wait for try-ons or return with opened packages."],
    ["Where can I find the size chart?", "The size chart is available on our Size Guide page and linked from every product page."],
    ["How long does delivery take?", "Orders are delivered within 5–8 business days in Cairo, Giza, and Alexandria. Deliveries to other governorates take up to 9 business days."],
    ["Can I make my order arrive faster?", "Unfortunately, no. Orders are shipped according to the courier’s delivery schedule, and delivery times cannot be expedited."],
    ["Do you have a physical store?", "No, we operate exclusively online."],
    ["Do you allow exchanges/returns?", "Yes, but some items may not be eligible for returns or exchanges. Please review our return/exchange policy on the website before placing your order."],
    ["How to request a refund, exchange, or cancel my order?", "Please send an email to: veekegy@gmail.com. Please note: Orders are confirmed one day after being placed. Once confirmed, cancellations are not allowed."],
    ["How can I contact you?", "Reach out through DM, our Contact Us page, or email: veekegy@gmail.com."],
    ["What happens if the courier cannot deliver my order?", "The courier will attempt delivery once. If the order is not received, it will be automatically canceled."],
    ["Can I order two sizes of the same item and pay for the one that fits?", "This is not allowed. Such orders are automatically canceled by our website system. This is against our policy, and couriers are not allowed to return opened packages."]
  ].forEach(([q, a]) => { %>
    <details class="acc" data-reveal>
      <summary><%= q %> <span class="plus"></span></summary>
      <div class="acc__body"><%= a %></div>
    </details>
  <% }) %>
</div>

<%- include('partials/footer') %>
