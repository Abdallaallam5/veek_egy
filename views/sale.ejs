<%- include('partials/header', { title: 'Sale' }) %>

<%
  const saleProducts = (products || []).filter(p => Number(p.salePrice) > 0 && Number(p.salePrice) < Number(p.price));
  const maxOff = saleProducts.reduce((m, p) => Math.max(m, Math.round((1 - p.salePrice / p.price) * 100)), 0);
%>

<section class="hero" style="margin-bottom:clamp(28px,4vw,52px)">
  <div class="container" style="padding-top:clamp(48px,8vw,110px);padding-bottom:clamp(40px,6vw,80px)">
    <span class="eyebrow" style="color:rgba(255,255,255,.6)">Limited time</span>
    <h1 class="display page-hero__title lines" style="margin-top:14px">
      <span class="line"><span style="--i:0">Up to</span></span>
      <span class="line"><span style="--i:1" class="outline"><%= maxOff || 20 %>% off</span></span>
    </h1>
    <p class="hero__lead" data-reveal style="--d:400;margin-bottom:0"><%= saleProducts.length %> pieces on sale while stock lasts.</p>
  </div>
</section>

<div class="container">
  <% if (!saleProducts.length) { %>
    <div class="empty-state">
      <p class="display">No sale right now</p>
      <p>Stay tuned — the next drop is coming.</p>
      <a href="/" class="btn">Shop new in</a>
    </div>
  <% } else { %>
    <div class="grid" style="padding-bottom:clamp(56px,8vw,110px)">
      <% saleProducts.forEach(product => { %>
        <%- include('partials/product-card', { product }) %>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
