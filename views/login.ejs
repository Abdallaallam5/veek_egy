<%- include('partials/header', { title: 'Login' }) %>

<div class="narrow">
  <h1 class="display lines"><span class="line"><span>Login</span></span></h1>

  <form action="/user/login" method="POST" data-reveal>
    <div class="field">
      <label for="l-email">Email</label>
      <input class="input" id="l-email" type="email" name="email" autocomplete="email" required>
    </div>
    <div class="field">
      <label for="l-password">Password</label>
      <input class="input" id="l-password" type="password" name="password" autocomplete="current-password" required>
    </div>
    <button type="submit" class="btn btn--block">Login</button>
  </form>

  <p class="alt">Don’t have an account? <a href="/user/signup">Sign up</a></p>
</div>

<%- include('partials/footer') %>
