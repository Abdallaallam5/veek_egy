<%
  const FREE_SHIP = 1499;
  const subtotal = cartItems.reduce((sum, i) => sum + Number(i.selectedPrice) * i.quantity, 0);
  const count = cartItems.reduce((sum, i) => sum + i.quantity, 0);
%>
<%- include('partials/header', { title: 'Your bag' }) %>

<div class="container">
  <header class="page-hero">
    <span class="eyebrow">Shopping bag</span>
    <h1 class="display page-hero__title lines">
      <span class="line"><span>Your bag<sup class="section-head__count" id="bagCount"><%= String(count).padStart(2, '0') %></sup></span></span>
    </h1>
  </header>

  <div id="cartRoot">
  <% if (!cartItems.length) { %>
    <div class="empty-state">
      <p class="display">Your bag is empty</p>
      <p>Looks like you haven’t added anything yet.</p>
      <a href="/" class="btn">Start shopping</a>
    </div>
  <% } else { %>
    <div class="cart">
      <div class="cart__lines">
        <% cartItems.forEach((item, i) => { %>
          <div class="cart-line" data-id="<%= item._id %>" data-line-total="<%= Number(item.selectedPrice) * item.quantity %>" data-line-qty="<%= item.quantity %>" data-reveal style="--d:<%= i * 80 %>">
            <a href="/product/<%= item._id %>" class="cart-line__img">
              <img src="<%= (item.images && item.images[0]) || '/images/photo_2026-01-06_18-49-05.jpg' %>" alt="<%= item.name %>">
            </a>
            <div>
              <h2 class="cart-line__name"><a href="/product/<%= item._id %>"><%= item.name %></a></h2>
              <div class="cart-line__meta">
                <% if (item.selectedSize) { %><span>Size: <%= item.selectedSize %></span><% } %>
                <% if (item.selectedColor) { %><span>Color: <%= item.selectedColor %></span><% } %>
                <span>Qty: <%= item.quantity %></span>
                <span><%= item.selectedPrice %> EGP each</span>
              </div>
            </div>
            <div class="cart-line__right">
              <span class="cart-line__total"><%= Number(item.selectedPrice) * item.quantity %> EGP</span>
              <button type="button" class="text-btn remove-btn">Remove</button>
            </div>
          </div>
        <% }) %>
      </div>

      <aside class="summary" data-reveal style="--d:150">
        <h2 class="summary__title">Order summary</h2>

        <div class="ship-meter">
          <p id="shipText">
            <% if (subtotal >= FREE_SHIP) { %>
              You’ve unlocked <b>free shipping</b> ✓
            <% } else { %>
              Add <b><%= FREE_SHIP - subtotal %> EGP</b> more for free shipping
            <% } %>
          </p>
          <div class="ship-meter__bar"><i id="shipBar" style="--p:0%" data-target="<%= Math.min(100, Math.round(subtotal / FREE_SHIP * 100)) %>%"></i></div>
        </div>

        <div class="summary__row"><span>Subtotal</span><span id="cartSubtotal"><%= subtotal %> EGP</span></div>
        <div class="summary__row"><span>Shipping</span><span>Calculated at checkout</span></div>
        <div class="summary__row summary__row--total"><span>Total</span><span id="cartTotal"><%= subtotal %> EGP</span></div>

        <a href="/checkout/get" class="btn btn--block" data-magnetic>Checkout</a>
        <p class="summary__note">Cash on delivery · Max 10 items per order</p>
      </aside>
    </div>
  <% } %>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var FREE_SHIP = <%= FREE_SHIP %>;
  var bar = document.getElementById("shipBar");
  if (bar) setTimeout(function () { bar.style.setProperty("--p", bar.dataset.target); }, 400);

  function recalc() {
    var lines = document.querySelectorAll(".cart-line");
    var subtotal = 0, count = 0;
    lines.forEach(function (l) {
      subtotal += Number(l.dataset.lineTotal) || 0;
      count += Number(l.dataset.lineQty) || 0;
    });
    document.getElementById("bagCount").textContent = String(count).padStart(2, "0");

    if (!lines.length) {
      document.getElementById("cartRoot").innerHTML =
        '<div class="empty-state"><p class="display">Your bag is empty</p><p>Looks like you haven’t added anything yet.</p><a href="/" class="btn">Start shopping</a></div>';
      return;
    }

    document.getElementById("cartSubtotal").textContent = subtotal + " EGP";
    document.getElementById("cartTotal").textContent = subtotal + " EGP";
    document.getElementById("shipText").innerHTML = subtotal >= FREE_SHIP
      ? "You’ve unlocked <b>free shipping</b> ✓"
      : "Add <b>" + (FREE_SHIP - subtotal) + " EGP</b> more for free shipping";
    bar.style.setProperty("--p", Math.min(100, Math.round(subtotal / FREE_SHIP * 100)) + "%");
  }

  document.querySelectorAll(".remove-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var productId = btn.closest(".cart-line").dataset.id;
      btn.disabled = true;

      fetch("/cart/remove", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ productId: productId })
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (!data.success) throw new Error();
          // the server removes every variant of this product
          var lines = document.querySelectorAll('.cart-line[data-id="' + productId + '"]');
          lines.forEach(function (l) { l.classList.add("is-removing"); });
          setTimeout(function () {
            lines.forEach(function (l) { l.remove(); });
            recalc();
          }, 450);
          Veek.setCartCount(data.totalQuantity || 0);
          Veek.toast("Removed from your bag");
        })
        .catch(function () {
          btn.disabled = false;
          Veek.toast("Couldn’t remove the item, please try again", "error");
        });
    });
  });
});
</script>

<%- include('partials/footer') %>
