<%- include('partials/header', { title: 'Sign up' }) %>

<div class="narrow">
  <h1 class="display lines"><span class="line"><span>Sign up</span></span></h1>

  <form action="/user/signup" method="POST" data-reveal>
    <div class="field">
      <label for="s-name">Name</label>
      <input class="input" id="s-name" type="text" name="name" autocomplete="name" required>
    </div>
    <div class="field">
      <label for="s-email">Email</label>
      <input class="input" id="s-email" type="email" name="email" autocomplete="email" required>
    </div>
    <div class="field">
      <label for="s-password">Password</label>
      <input class="input" id="s-password" type="password" name="password" autocomplete="new-password" required>
    </div>
    <button type="submit" class="btn btn--block">Create account</button>
  </form>

  <p class="alt">Already have an account? <a href="/user/login">Login</a></p>
</div>

<%- include('partials/footer') %>
