<%- include('partials/header', { title: 'Checkout' }) %>

<div class="container">
  <header class="page-hero">
    <span class="eyebrow">Secure checkout · Cash on delivery</span>
    <h1 class="display page-hero__title lines"><span class="line"><span>Checkout</span></span></h1>
  </header>

  <form id="checkoutForm" novalidate>
    <div class="checkout">

      <!-- ================= LEFT ================= -->
      <div>
        <section class="checkout-step" data-reveal>
          <div class="checkout-step__head"><span class="checkout-step__num">1</span><h2>Contact</h2></div>

          <div class="field">
            <label for="f-name">Full name</label>
            <input class="input" id="f-name" name="name" autocomplete="name" placeholder="Your full name">
            <small class="error-msg" id="error-name"></small>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="f-email">Email</label>
              <input class="input" id="f-email" name="email" type="email" autocomplete="email" placeholder="name@gmail.com">
              <small class="error-msg" id="error-email"></small>
            </div>
            <div class="field">
              <label for="f-phone">Phone</label>
              <input class="input" id="f-phone" name="phone" placeholder="01xxxxxxxxx" maxlength="11" inputmode="numeric" autocomplete="tel">
              <small class="error-msg" id="error-phone"></small>
            </div>
          </div>
        </section>

        <section class="checkout-step" data-reveal style="--d:100">
          <div class="checkout-step__head"><span class="checkout-step__num">2</span><h2>Shipping</h2></div>

          <div class="field">
            <label for="citySelect">Governorate</label>
            <select class="select" name="city" id="citySelect">
              <option value="">Select governorate</option>
              <% [
                "Cairo","Giza","Alexandria","Dakahlia","Red Sea","Beheira",
                "Fayoum","Gharbia","Ismailia","Menofia","Minya","Qaliubiya",
                "New Valley","Suez","Aswan","Assiut","Beni Suef","Port Said",
                "Damietta","Sharkia","South Sinai","Kafr El Sheikh","Matrouh",
                "Luxor","Qena","Sohag"
              ].forEach(g => { %>
                <option value="<%= g %>"><%= g %></option>
              <% }) %>
            </select>
            <small class="error-msg" id="error-city"></small>
          </div>

          <div class="field">
            <label for="f-address">Address</label>
            <input class="input" id="f-address" name="address" autocomplete="street-address" placeholder="Street, building, floor, apartment">
            <small class="error-msg" id="error-address"></small>
          </div>
        </section>

        <section class="checkout-step" data-reveal style="--d:200">
          <div class="checkout-step__head"><span class="checkout-step__num">3</span><h2>Promo code</h2></div>
          <div class="coupon">
            <input class="input" type="text" id="couponCode" placeholder="Enter code" autocomplete="off">
            <button type="button" class="btn btn--ghost" id="applyCoupon">Apply</button>
          </div>
          <p id="couponMessage-left" class="coupon-msg"></p>
        </section>

        <section class="checkout-step" data-reveal style="--d:300">
          <div class="checkout-step__head"><span class="checkout-step__num">4</span><h2>Payment</h2></div>
          <div class="cod-note">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="1"/><circle cx="12" cy="12" r="2.5"/></svg>
            <div><b>Cash on delivery</b><small>Pay the courier when your order arrives.</small></div>
          </div>
        </section>

        <button type="submit" class="btn btn--block checkout-btn" data-reveal style="--d:350">Confirm order</button>
      </div>

      <!-- ================= RIGHT ================= -->
      <aside class="checkout-summary">
        <div class="summary" data-reveal="fade">
          <h2 class="summary__title">Your order</h2>

          <% cartItems.forEach(item => { %>
            <div class="order-item">
              <div class="order-item__img">
                <img src="<%= (item.images && item.images[0]) || '/images/photo_2026-01-06_18-49-05.jpg' %>" alt="<%= item.name %>">
                <span class="order-item__qty"><%= item.quantity %></span>
              </div>
              <div>
                <h4><%= item.name %></h4>
                <p>
                  <%= [item.selectedSize, item.selectedColor].filter(Boolean).join(' · ') %>
                </p>
              </div>
              <span class="order-item__price"><%= Number(item.selectedPrice) * item.quantity %> EGP</span>

              <input type="hidden" name="productId[]" value="<%= item._id %>">
              <input type="hidden" name="quantity[]" value="<%= item.quantity %>">
              <input type="hidden" name="price[]" value="<%= item.selectedPrice %>">
              <input type="hidden" name="size[]" value="<%= item.selectedSize || '' %>">
              <input type="hidden" name="color[]" value="<%= item.selectedColor || '' %>">
            </div>
          <% }) %>

          <div style="margin-top:20px">
            <div class="summary__row"><span>Subtotal</span><span id="subtotal" data-value="<%= subtotal %>"><%= subtotal %> EGP</span></div>
            <div class="summary__row"><span>Discount</span><span id="discount" data-value="0">0 EGP</span></div>
            <div class="summary__row">
              <span>Shipping</span>
              <span><span id="shipping" data-value="<%= shipping %>"><%= subtotal >= 1499 ? 'Free' : 'Select governorate' %></span><span id="message" class="free-ship-msg"></span></span>
            </div>
            <div class="summary__row summary__row--total"><span>Total</span><span id="total" data-value="<%= subtotal + shipping %>"><%= subtotal + shipping %> EGP</span></div>
          </div>
        </div>
      </aside>

    </div>
  </form>
</div>

<!-- Loading / success overlay -->
<div class="overlay-status" id="statusOverlay" aria-live="assertive">
  <div id="statusLoading">
    <div class="spinner"></div>
    <p>Placing your order…</p>
  </div>
  <div id="statusDone" hidden>
    <svg class="check-anim" viewBox="0 0 76 76" fill="none" stroke="#0a0a0a" stroke-width="2">
      <circle cx="38" cy="38" r="36"/>
      <path d="M24 39l10 10 19-21"/>
    </svg>
    <h2 class="display" style="font-size:clamp(32px,6vw,56px)">Thank you</h2>
    <p>Your order has been placed</p>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var form = document.getElementById("checkoutForm");
  var citySelect = document.getElementById("citySelect");
  var couponInput = document.getElementById("couponCode");
  var couponMsg = document.getElementById("couponMessage-left");
  var submitBtn = form.querySelector(".checkout-btn");

  function field(name) { return form.querySelector('[name="' + name + '"]'); }

  function setError(name, message) {
    field(name).classList.add("input-error");
    document.getElementById("error-" + name).textContent = message;
  }

  function clearErrors() {
    form.querySelectorAll(".error-msg").forEach(function (el) { el.textContent = ""; });
    form.querySelectorAll(".input-error").forEach(function (el) { el.classList.remove("input-error"); });
  }

  function validateForm() {
    clearErrors();
    var ok = true;
    var name = field("name").value.trim();
    var email = field("email").value.trim();
    var phone = field("phone").value.trim();
    var address = field("address").value.trim();

    if (name.length < 3) { setError("name", "Name must be at least 3 characters"); ok = false; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setError("email", "Enter a valid email"); ok = false; }
    else if (!/@gmail\.com$/i.test(email)) { setError("email", "Please use a Gmail address"); ok = false; }
    if (!/^01[0125][0-9]{8}$/.test(phone)) { setError("phone", "Enter a valid number like 01000000000"); ok = false; }
    if (!citySelect.value) { setError("city", "Please select a governorate"); ok = false; }
    if (address.length < 5) { setError("address", "Address is too short"); ok = false; }

    if (!ok) {
      var first = form.querySelector(".input-error");
      if (first) first.scrollIntoView({ behavior: "smooth", block: "center" });
    }
    return ok;
  }

  field("phone").addEventListener("input", function () {
    this.value = this.value.replace(/\D/g, "").slice(0, 11);
  });

  form.querySelectorAll(".input, .select").forEach(function (el) {
    el.addEventListener("input", function () {
      el.classList.remove("input-error");
      var err = document.getElementById("error-" + el.name);
      if (err) err.textContent = "";
    });
  });

  function setMoney(id, value, text) {
    var el = document.getElementById(id);
    var changed = Number(el.dataset.value) !== Number(value);
    el.dataset.value = value;
    el.textContent = text !== undefined ? text : (Math.round(value * 100) / 100) + " EGP";
    if (changed) {
      el.classList.remove("value-flash");
      void el.offsetWidth;
      el.classList.add("value-flash");
    }
  }

  function updatePrices(fromCouponBtn) {
    var subtotal = Number(document.getElementById("subtotal").dataset.value) || 0;
    var governorate = citySelect.value;

    if (!governorate) {
      if (fromCouponBtn) {
        setError("city", "Select your governorate first");
        citySelect.focus();
      }
      return;
    }

    var btn = document.getElementById("applyCoupon");
    if (fromCouponBtn) btn.classList.add("is-loading");

    fetch("/checkout/calculate?subtotal=" + subtotal +
      "&code=" + encodeURIComponent(couponInput.value.trim()) +
      "&governorate=" + encodeURIComponent(governorate))
      .then(function (res) { return res.json(); })
      .then(function (data) {
        if (!data.success) return;
        setMoney("discount", data.discount, data.discount ? "− " + (Math.round(data.discount * 100) / 100) + " EGP" : "0 EGP");
        setMoney("shipping", data.shipping, data.shipping ? undefined : "Free");
        setMoney("total", data.total);
        couponMsg.textContent = data.message || "";
        couponMsg.className = "coupon-msg " + (data.discount > 0 ? "ok" : "bad");
      })
      .catch(function () { Veek.toast("Couldn’t update prices, please try again", "error"); })
      .finally(function () { btn.classList.remove("is-loading"); });
  }

  citySelect.addEventListener("change", function () { updatePrices(false); });
  document.getElementById("applyCoupon").addEventListener("click", function () { updatePrices(true); });
  couponInput.addEventListener("keydown", function (e) {
    if (e.key === "Enter") { e.preventDefault(); updatePrices(true); }
  });

  var overlay = document.getElementById("statusOverlay");

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    if (!validateForm()) return;

    submitBtn.disabled = true;
    overlay.classList.add("is-on");

    var fd = new FormData(form);
    var ids = fd.getAll("productId[]");
    var quantities = fd.getAll("quantity[]");
    var prices = fd.getAll("price[]");
    var sizes = fd.getAll("size[]");
    var colors = fd.getAll("color[]");

    var products = ids.map(function (id, i) {
      return {
        product: id,
        quantity: parseInt(quantities[i], 10),
        price: parseFloat(prices[i]),
        size: sizes[i] || null,
        color: colors[i] || null
      };
    });

    fetch("/checkout/place-order", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        products: products,
        customerName: fd.get("name").trim(),
        customerEmail: fd.get("email").trim(),
        customerNumber: fd.get("phone").trim(),
        customerAddress: fd.get("address").trim(),
        governorate: fd.get("city"),
        shipping: Number(document.getElementById("shipping").dataset.value) || 0,
        discount: Number(document.getElementById("discount").dataset.value) || 0,
        total: Number(document.getElementById("total").dataset.value) || 0,
        couponCode: couponInput.value.trim() || null
      })
    })
      .then(function (res) {
        return res.json().then(function (result) { return { ok: res.ok, result: result }; });
      })
      .then(function (r) {
        if (r.ok) {
          document.getElementById("statusLoading").hidden = true;
          document.getElementById("statusDone").hidden = false;
          Veek.setCartCount(0);
          setTimeout(function () { window.location.href = "/"; }, 2400);
        } else {
          overlay.classList.remove("is-on");
          submitBtn.disabled = false;
          Veek.toast(r.result.error || "Something went wrong", "error");
        }
      })
      .catch(function () {
        overlay.classList.remove("is-on");
        submitBtn.disabled = false;
        Veek.toast("Something went wrong, please try again", "error");
      });
  });
});
</script>

<%- include('partials/footer') %>
