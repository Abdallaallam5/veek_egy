# ================= VEEK — environment =================
# Never commit real secrets. Production values live in Vercel → Settings → Environment Variables.

# ---------- Server ----------
PORT=10000

# ---------- MongoDB Atlas ----------
# config/db.js reads MONGO_URI, server.js reads MONGODB_URI — keep both identical.
MONGO_URI=
MONGODB_URI=

# ---------- Auth ----------
JWT_SECRET=

# ---------- Email (Gmail App Password) ----------
EMAIL_USER=
EMAIL_PASS=

# ---------- Cloudinary (image uploads) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
